---
const {header, beskrivelse, billede, nr, color} = Astro.props;
---

<article >
    <a href="#">
    <div class="carddesign">
        <img src={billede} alt="billede">
        <div class="mix" >
            <h3 style=`background-color:${color}`>{header}</h3>
            <h2 style=`background-color:${color}`>{nr}</h2>
        </div>
        <div class="beskrivelse">
            <p>{beskrivelse}</p>
        </div>
    </div>
    </a>  
</article>

<style>
.mix{
    display: flex;
    justify-content: space-between;
    position: absolute;
    top: 60%;
    gap: 70px;
    
    h3{
        color:black;
        margin-left: 8px;
        padding: 5px;
    }
    h2{
        color:black;
    }
}
    img{
        border-radius: 10px;
        width: 100%;
    }
    .carddesign{
    width: 200px;
    padding: 10px;
        }
        .carddesign:hover{
        background-color: rgba(255, 255, 255, 0.122); 
        border-radius: 20px;
    }
    .beskrivelse{
        color:rgb(118, 118, 118);
    }
    a{
        text-decoration: none;
    }
    
</style>