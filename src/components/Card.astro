---
const {header, beskrivelse, billede} = Astro.props;
---

<article>
    <a href="#">
    <div class="carddesign">
        <img src={billede} alt="billede">
        <div class="beskrivelse">
            <h2>{header}</h2>
            <p>{beskrivelse}</p>
        </div>
    </div>  
    </a>  
</article>

<style>
    
    article{
        margin: 10px;
        border-radius: 30px;
        a{
            text-decoration: none;
            color: rgb(161, 158, 158);
        }
         img{
            border-radius: 30px;
            
        }
        .beskrivelse{
            margin: 10px;
        }
    }
    article:hover{
        background-color: rgba(255, 255, 255, 0.122); 
    }
    .carddesign{
        margin: 10px;
    }
</style>