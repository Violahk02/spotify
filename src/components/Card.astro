---
const {header, beskrivelse, billede} = Astro.props;
---

<article>
    <a href="#">
    <div class="carddesign">
        <img src={billede} alt="billede">
        <div class="beskrivelse">
            <h2>{header}</h2>
            <p>{beskrivelse}</p>
        </div>
    </div>
    </a>  
</article>

<style>
    img{
        border-radius: 10px;
        width: 100%;
    }
    .carddesign{
    width: 200px;
    padding: 10px;
        }
        .carddesign:hover{
        background-color: rgba(255, 255, 255, 0.122); 
        border-radius: 20px;
    }
    .beskrivelse{
        color:rgb(118, 118, 118);
    }
    a{
        text-decoration: none;
    }
